<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="$(var.ProductCode)" Name="MusatPlay" Language="!(loc.Language)" Version="$(var.Version)" Manufacturer="musatDev" UpgradeCode="8396c54a-b754-4de9-bf6a-403418c86c6f">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="!(loc.NewerInstalled)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />
    <Icon Id="AppIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="MENUSHORTCUT" Value="1" Secure="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder"><Directory Id="Programs" Name="Programs"><Directory Id="INSTALLFOLDER" Name="MusatPlay" /></Directory></Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="ProgramMenuFolder"><Directory Id="AppMenu" Name="MusatPlay" /></Directory>
    </Directory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="FolderCleanup" Guid="*" Win64="yes">
        <RemoveFolder Id="RemoveProgramsIfEmpty" Directory="Programs" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\musatDev\MusatPlay" Name="UILanguage" Type="string" Value="[ProductLanguage]" />
        <RegistryValue Root="HKCU" Key="Software\musatDev\MusatPlay" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopLink" Guid="*" Win64="yes">
        <Condition>DESKTOPSHORTCUT = "1"</Condition>
        <Shortcut Id="DesktopShortcut" Name="MusatPlay" Target="[INSTALLFOLDER]MusatPlay.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\musatDev\MusatPlay" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="AppMenu">
      <Component Id="MenuLinks" Guid="*" Win64="yes">
        <Condition>MENUSHORTCUT = "1"</Condition>
        <Shortcut Id="MenuShortcut" Name="MusatPlay" Target="[INSTALLFOLDER]MusatPlay.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="RemoveShortcut" Name="Uninstall MusatPlay" Target="[INSTALLFOLDER]Uninstall.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\musatDev\MusatPlay" Name="MenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Application" Title="MusatPlay" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="FolderCleanup" />
      <ComponentRef Id="DesktopLink" /><ComponentRef Id="MenuLinks" />
    </Feature>
    <UIRef Id="MusatPlayUI" />
  </Product>
  <Fragment>
    <UI Id="MusatPlayUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />
      <Property Id="ARPNOMODIFY" Value="1" />
      <DialogRef Id="BrowseDlg" /><DialogRef Id="DiskCostDlg" /><DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" /><DialogRef Id="FilesInUse" /><DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" /><DialogRef Id="ProgressDlg" /><DialogRef Id="ResumeDlg" /><DialogRef Id="UserExit" />
      <Dialog Id="ShortcutOptionsDlg" Width="370" Height="270" Title="!(loc.SetupTitle)">
        <Control Id="Title" Type="Text" X="15" Y="12" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.OptionsTitle)" />
        <Control Id="FolderLabel" Type="Text" X="20" Y="48" Width="330" Height="18" Text="Install location" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="70" Width="265" Height="18" Property="INSTALLFOLDER" />
        <Control Id="Browse" Type="PushButton" X="292" Y="70" Width="58" Height="18" Text="Browse…">
          <Publish Property="_BrowseProperty" Value="INSTALLFOLDER" Order="1">1</Publish>
          <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
        </Control>
        <Control Id="Desktop" Type="CheckBox" X="20" Y="118" Width="330" Height="20" Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="!(loc.DesktopShortcut)" />
        <Control Id="Menu" Type="CheckBox" X="20" Y="148" Width="330" Height="20" Property="MENUSHORTCUT" CheckBoxValue="1" Text="!(loc.MenuShortcut)" />
        <Control Id="Line" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.Back)"><Publish Event="NewDialog" Value="WelcomeDlg">1</Publish></Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.Next)">
          <Publish Event="SetTargetPath" Value="INSTALLFOLDER" Order="1">1</Publish>
          <Publish Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
          <Publish Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID <> "1"]]></Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.Cancel)"><Publish Event="SpawnDialog" Value="CancelDlg">1</Publish></Control>
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ShortcutOptionsDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ShortcutOptionsDlg">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath" Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID <> "1"]]></Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath" Order="3">1</Publish>
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID <> "1"]]></Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutOptionsDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3">Installed AND PATCH</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
